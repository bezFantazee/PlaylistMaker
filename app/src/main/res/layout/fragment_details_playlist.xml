<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playlistDetailsFragment"
    android:theme="@style/Base.Theme.PlaylistMaker"
    android:background="@color/light_gray">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/playlistImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/backButton"
            android:src="@drawable/ic_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"

            app:tint="@color/black" />

        <TextView
            android:id="@+id/playlistName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playlistImage"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"

            android:textColor="@color/black"
            android:textSize="24sp"
            android:fontFamily="@font/ys_display_bold"
            android:textFontWeight="700"
            android:ellipsize="end"
            android:maxLines="1"

            tools:text = "Название"/>

        <TextView
            android:id="@+id/playlistDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/playlistName"
            app:layout_constraintStart_toStartOf="@id/playlistName"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"

            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/ys_display_regular"
            android:textFontWeight="400"
            android:ellipsize="end"
            android:maxLines="1"

            tools:text = "Описание"/>

        <androidx.constraintlayout.widget.Group
            android:id="@+id/timeAndTracksGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="playlistTracksFullTime,separator,playlistTracksCount"/>

        <TextView
            android:id="@+id/playlistTracksFullTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/playlistDescription"
            app:layout_constraintStart_toStartOf="@id/playlistName"
            android:layout_marginTop="8dp"

            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/ys_display_regular"
            android:textFontWeight="400"

            tools:text = "223 минут"/>

        <ImageView
            android:id="@+id/separator"
            android:layout_width="13dp"
            android:layout_height="13dp"
            app:layout_constraintStart_toEndOf="@id/playlistTracksFullTime"
            app:layout_constraintTop_toTopOf="@id/playlistTracksFullTime"
            app:layout_constraintBottom_toBottomOf="@id/playlistTracksFullTime"

            app:srcCompat="@drawable/ic_dot"
            app:tint="@color/black" />

        <TextView
            android:id="@+id/playlistTracksCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/playlistTracksFullTime"
            app:layout_constraintStart_toEndOf="@id/separator"

            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/ys_display_regular"
            android:textFontWeight="400"

            tools:text = "121 трек"/>

        <ImageView
            android:id="@+id/shareButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintTop_toBottomOf="@id/playlistTracksFullTime"
            app:layout_constraintStart_toStartOf="@id/playlistName"
            android:layout_marginTop="16dp"

            android:src="@drawable/ic_share"
            app:tint="@color/black" />

        <ImageView
            android:id="@+id/menuButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintTop_toTopOf="@id/shareButton"
            app:layout_constraintStart_toEndOf="@id/shareButton"
            android:layout_marginStart="16dp"

            android:src="@drawable/ic_menu"
            app:tint="@color/black" />


    </androidx.constraintlayout.widget.ConstraintLayout>
    <!--BottomSheet-->

    <LinearLayout
        android:id="@+id/tracksBottomSheetContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingVertical="8dp"
        app:behavior_hideable="false"
        app:behavior_fitToContents="true"
        android:background="@drawable/bottom_sheet_background"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/somethig_background" />

        <TextView
            android:id="@+id/tracksPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_tracks_in_playlist"
            android:textSize="19sp"
            android:textColor="?attr/colorOnPrimary"
            android:textFontWeight="500"
            android:fontFamily="@font/ys_display_medium"
            android:textAlignment="center"
            android:paddingVertical="12dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tracks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:paddingVertical="12dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuBottomSheetContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingVertical="8dp"
        app:behavior_hideable="true"
        android:background="@drawable/bottom_sheet_background"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"

        android:paddingStart="16dp">

        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/somethig_background"
            android:layout_marginBottom="12dp"/>

        <include
            android:id="@+id/playlistSmallCard"
            layout="@layout/playlist_small_card" />

        <TextView
            android:id="@+id/shareMenuButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp"
            android:textFontWeight="400"
            android:fontFamily="@font/ys_display_regular"

            android:paddingVertical="21dp"
            android:paddingEnd="44dp"

            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/editMenuButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/edit_playlist"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp"
            android:textFontWeight="400"
            android:fontFamily="@font/ys_display_regular"

            android:paddingVertical="21dp"
            android:paddingEnd="44dp"/>

        <TextView
            android:id="@+id/deleteMenuButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delete_playlist"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp"
            android:textFontWeight="400"
            android:fontFamily="@font/ys_display_regular"

            android:paddingVertical="21dp"
            android:paddingEnd="44dp"/>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
