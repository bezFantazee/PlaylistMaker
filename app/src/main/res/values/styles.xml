<?xml version="1.0" encoding="utf-8"?>
<resources>
<!--    Главный экран(уже не используется)-->
    <style name="Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <!-- Размеры -->
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center_vertical|center_horizontal</item>

        <!-- Внешний вид -->
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>

        <!-- Текст -->
        <item name="android:textAppearance">@style/ButtonText</item>

        <!-- Иконка слева от текста -->
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/black</item>
        <item name="android:drawablePadding">@dimen/distance_after_icon</item>
    </style>
    <style name="ButtonText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textFontWeight">500</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/standart_text_size</item>
        <item name="textAllCaps">false</item>

    </style>
<!--    Экран настроек-->
    <style name="SettingsIcon" parent="BaseIcon">
        <item name="android:tint">?attr/colorOnBackground</item>

    </style>
    <style name="SettingsButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">61dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

<!--    Общие стили-->
    <style name="BaseIcon">
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:layout_height">@dimen/icon_size</item>
        <item name="android:layout_width">@dimen/icon_size</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
    </style>

    <style name="BaseText">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>
    <style name="PrimaryText" parent="BaseText">
        <item name="android:textSize">@dimen/standart_text_size</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="SecondaryText" parent="BaseText">
        <item name="android:textSize">19sp</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="BodyText" parent="BaseText">
        <item name="android:textSize">19sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textAlignment">center</item>
    </style>
    <style name="BodySmallText" parent="BaseText">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/small_text_size</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="MenuText" parent="BodySmallText">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_marginStart">@dimen/small_margin</item>
        <item name="android:paddingVertical">21dp</item>
    </style>

    <style name="SmallButton" parent="Button">
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:backgroundTint">?attr/colorOnPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="cornerRadius">54dp</item>
        <item name="android:stateListAnimator">@animator/button_press_scale</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <style name="MediumButton" parent="Button">
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

<!--    Плейлист-->
    <style name="PlaylistDescriptionText" parent="BaseText">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textFontWeight">400</item>
    </style>
<!--    Маленькие карточки-->
    <style name="SmallCardImage">
        <item name="android:width">@dimen/medium_icon_size</item>
        <item name="android:height">@dimen/medium_icon_size</item>
    </style>

    <style name="SmallCardPrimaryText">
        <item name="android:textSize">@dimen/small_text_size</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="SmallCardSecondaryText" parent="SmallCardPrimaryText">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>
<!--    Аудиоплеер-->
    <style name="trackDescription">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_grey</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
    </style>
<!--    Медиатека-->
    <style name="CustomTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="textAllCaps">false</item>
        <item name="tabTextColor">?attr/colorOnPrimary</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="fontWeight">500</item>
    </style>

<!--    Bottom navigation-->
    <style name="BottomNavText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/very_small_text</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>
    <style name="CustomBottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemPaddingBottom">0dp</item>
        <item name="itemPaddingTop">0dp</item>
    </style>
</resources>